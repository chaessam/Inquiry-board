{
  "name": "inquiry-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "개념기반탐구 수업을 위한 수업 종합 도구, 탐구보드",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply inquiry-board --local",
    "db:migrate:remote": "wrangler d1 migrations apply inquiry-board --remote",
    "serve": "npm run build && wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@fontsource/gothic-a1": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "preact": "^10.26.0",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "vite": "^6.3.0",
    "wrangler": "^4.20.0"
  }
}
